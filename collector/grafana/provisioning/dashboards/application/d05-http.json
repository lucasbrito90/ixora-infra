        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ixora_http_server_request_total{environment=~\"$environment\",outcome=\"server_error\"}[5m])) / sum(rate(ixora_http_server_request_total{environment=~\"$environment\"}[5m]))",
          "instant": true,
          "legendFormat": "5xx rate",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Server Error Rate (5xx)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "95th percentile HTTP response latency across all routes (milliseconds). Healthy: < 500 ms. Above 2000 ms warrants investigation. Note: this is the application processing time measured at the middleware boundary — excludes network transit time.",
