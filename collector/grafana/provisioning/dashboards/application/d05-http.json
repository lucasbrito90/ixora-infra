      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "topk(15, sum by(http_route) (increase(ixora_http_server_request_total{environment=~\"$environment\",outcome=\"server_error\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Top Error Routes (5xx, selected window)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_route": "Route",
              "Value": "5xx Errors"
            }
          }
        }
      ],
      "type": "table"
    },
