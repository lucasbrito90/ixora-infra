    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Failed scheduled event rate over time by event name. A sustained non-zero line on any event indicates that event is consistently throwing exceptions. Drill-down: Tempo → find scheduler.event span with ERROR status → Loki for exception_class and scheduler error context (SchedulerErrorContextLogTap fields).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "unit": "ops"
        },
        "overrides": []
