        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(event_name) (rate(ixora_scheduler_event_total{environment=~\"$environment\",outcome=\"failed\"}[5m]))",
          "instant": false,
          "legendFormat": "{{event_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failed Events by Name",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Failed event count broken down by event name for the selected time window. Use to identify which scheduled event has accumulated the most failures. Drill-down: Tempo → filter by event_name span attribute → Loki for root cause.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 302,
      "options": {
        "barWidth": 0.97,
        "fillOpacity": 80,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by(event_name) (increase(ixora_scheduler_event_total{environment=~\"$environment\",outcome=\"failed\"}[$__range])))",
          "instant": true,
          "legendFormat": "{{event_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failure Breakdown by Event (selected window)",
      "type": "barchart"
