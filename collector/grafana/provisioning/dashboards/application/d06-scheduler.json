  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Total scheduled event execution rate (all outcomes). Healthy: matches the number of events registered in the application schedule. For DispatchDueSchedulesCommand running every minute, expect ~1/min per scheduled event. Zero indicates the scheduler loop has stopped.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.001
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ixora_scheduler_event_total{environment=~\"$environment\"}[5m]))",
          "instant": true,
          "legendFormat": "executions/s",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Execution Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Fraction of scheduled events completing with outcome=success. Healthy: > 95% of foreground events succeed. Background events complete with outcome=background_completed (not failure/success) — see Throughput section for the full outcome breakdown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 102,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ixora_scheduler_event_total{environment=~\"$environment\",outcome=\"success\"}[5m])) / sum(rate(ixora_scheduler_event_total{environment=~\"$environment\",outcome!=\"overlap_prevented\",outcome!=\"skipped\"}[5m]))",
          "instant": true,
          "legendFormat": "success rate",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Success Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Rate of scheduled event failures (outcome=failed) per second. Healthy: 0. Any non-zero value means a scheduled event threw an exception — use Tempo to find the scheduler.event span with ERROR status, then Loki for the exception_class.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.0001
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 103,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ixora_scheduler_event_total{environment=~\"$environment\",outcome=\"failed\"}[5m]))",
          "instant": true,
          "legendFormat": "failures/s",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failure Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Rate of events prevented from running due to an overlapping instance (outcome=overlap_prevented). This is the idempotency guard firing correctly — a high rate is normal when the same event is scheduled more frequently than it takes to complete. Healthy: expected to be non-zero for long-running events.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 104,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ixora_scheduler_event_total{environment=~\"$environment\",outcome=\"overlap_prevented\"}[5m]))",
          "instant": true,
          "legendFormat": "overlap prevented/s",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Overlap Prevented Rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 200,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ixora-prometheus"
      },
      "description": "Scheduler event execution rate by outcome over time. Outcomes: success, failed, skipped (filter/mutex), overlap_prevented (idempotency), background_completed (async job launched). A healthy pattern shows steady success with occasional overlap_prevented when long-running events overlap their schedule frequency.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 201,
      "options": {
        "fillOpacity": 10,
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ixora-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(outcome) (rate(ixora_scheduler_event_total{environment=~\"$environment\"}[5m]))",
          "instant": false,
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Execution Rate by Outcome",
      "type": "timeseries"
    },
