{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "D-07 — Observability platform self-health. Answers: Is the telemetry infrastructure itself healthy? Covers Collector pipelines, export rates, queue depth, and Prometheus platform metrics. Exclusively infrastructure-scoped: no application, HTTP, Queue, Scheduler, Smart Home, or Push Notification metrics.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "title": "Platform Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Collector self-scrape health (push-based). Value = 1 (UP) when the Collector is alive and writing self-metrics to Prometheus. Note: uses push-based health check — may report stale UP for up to 5 min after Collector stops.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 1, "text": "DOWN"},
                "1": {"color": "green", "index": 0, "text": "UP"}
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null",
                "result": {"color": "orange", "index": 2, "text": "N/A"}
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "up{job=\"otel-collector\"}",
          "instant": true,
          "legendFormat": "Collector",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collector Process",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Prometheus self-scrape health. Value = 1 when Prometheus is up and its config last reload was successful.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 1, "text": "DOWN"},
                "1": {"color": "green", "index": 0, "text": "UP"}
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null",
                "result": {"color": "orange", "index": 2, "text": "N/A"}
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "up{job=\"prometheus\"}",
          "instant": true,
          "legendFormat": "Prometheus",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Prometheus",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Total accumulated uptime of the Collector process since last start. Resets to 0 on restart.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "orange", "value": null},
              {"color": "green", "value": 60}
            ]
          },
          "unit": "dtdhms"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "otelcol_process_uptime_total{service_name=\"otelcol-contrib\"}",
          "instant": true,
          "legendFormat": "Uptime",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collector Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Collector process resident set size (RSS) — physical memory in use. Alert if approaching container memory limit.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 400000000},
              {"color": "red", "value": 600000000}
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "otelcol_process_memory_rss{service_name=\"otelcol-contrib\"}",
          "instant": true,
          "legendFormat": "Memory RSS",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collector Memory (RSS)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Collector CPU usage as a fraction of one core (5-minute rate). 0.1 = 10% of 1 core.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 0.8}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "rate(otelcol_process_cpu_seconds_total{service_name=\"otelcol-contrib\"}[5m])",
          "instant": true,
          "legendFormat": "CPU",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collector CPU",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 10,
      "title": "OTLP Export Pipeline — Metrics",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
      "description": "Rate of metric points successfully pushed to Prometheus via remote write. Also shows failures per second. Baseline: ~2–5 points/s from Collector self-metrics + application metrics when back_vibes is active.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "failed/s"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 11,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "rate(otelcol_exporter_sent_metric_points_total{exporter=\"prometheusremotewrite\",service_name=\"otelcol-contrib\"}[5m])",
          "legendFormat": "sent/s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
          "editorMode": "code",
          "expr": "rate(otelcol_exporter_send_failed_metric_points_total{exporter=\"prometheusremotewrite\",service_name=\"otelcol-contrib\"}[5m])",
          "legendFormat": "failed/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Metric Export Rate (Prometheus Remote Write)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ixora-prometheus"},
