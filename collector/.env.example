# ============================================================
# Ixora Observability — Collector Environment Variables
# Phase 6 — Tempo Trace Backend
#
# Copy to .env and fill in values.
# NEVER commit .env to git — only .env.example.
# Secrets stored in DigitalOcean App Platform secrets or VM env
# files with chmod 600 (security-review.md §6).
# ============================================================

# ============================================================
# DEPLOYMENT IDENTITY
# ============================================================

# Environment name — MUST match telemetry-naming-convention.md §4.
# Allowed: development | staging | production
# FORBIDDEN: dev, prod, test, homolog, qa
OTEL_DEPLOYMENT_ENVIRONMENT=staging

# Collector service version (matches release tag).
OTEL_COLLECTOR_VERSION=0.115.1

# Prometheus service version (matches release tag).
# Pin to a specific version — never use :latest.
PROMETHEUS_VERSION=v2.54.1

# Loki service version (matches release tag).
# Pin to a specific version — never use :latest.
LOKI_VERSION=3.2.0

# Tempo service version (matches release tag).
# Pin to a specific version — never use :latest.
TEMPO_VERSION=2.6.0

# ============================================================
# OTLP AUTHENTICATION
# API keys for ingest — security-review.md §3.
# Generate with: openssl rand -hex 32
# Keep separate keys per client class to limit blast radius.
# ============================================================

# Key used by back_vibes-api and back_vibes-worker (App Platform).
OTEL_INGEST_API_KEY_BACKEND=REPLACE_WITH_STRONG_RANDOM_KEY

# Key used by front_vibes-android (staging APK build secret).
# Separate key so a leaked APK does not compromise backend auth.
OTEL_INGEST_API_KEY_MOBILE=REPLACE_WITH_STRONG_RANDOM_KEY

# ============================================================
# COLLECTOR RESOURCE LIMITS
# Tune these per VM size — infrastructure-review.md §10.
# Baseline: 4 vCPU / 8 GB RAM (128 GB disk)
# ============================================================

# memory_limiter processor hard limit (MiB).
# Recommended: ≈ 25% of VM RAM for Collector.
OTEL_MEMORY_LIMIT_MIB=512

# memory_limiter spike tolerance (MiB).
OTEL_MEMORY_SPIKE_LIMIT_MIB=128

# ============================================================
# SAMPLING
# Collector-side head sampling (ADR-031). This is the ONLY trace
# sampling point when back_vibes uses OTEL_TRACES_SAMPLER=always_on.
# Effective Tempo retention ≈ this percentage (not multiplicative).
# probabilistic_sampler does NOT guarantee 100% error retention;
# error-aware sampling requires future tail_sampling.
# ============================================================

# Staging trace sampling (Collector probabilistic_sampler, 0–100).
# 100 = retain all traces during end-to-end validation (temporary).
# 90  = retain approximately 9 out of 10 traces after validation.
# 10  = ADR-031 MVP default for production-style cost control.
OTEL_TRACE_SAMPLE_RATE_SUCCESS=100

# Mobile success trace sample rate (0–100) — reserved; not wired in
# collector/config.yaml yet. Documented for future mobile pipeline work.
OTEL_TRACE_SAMPLE_RATE_MOBILE=5

# ============================================================
# TLS (Phase 3 deployment — fill when certs provisioned)
# ============================================================

# Absolute path to TLS cert and key on the VM filesystem.
# Used when Collector terminates TLS directly (no reverse proxy).
# If Caddy/nginx handles TLS termination, leave empty.
OTEL_TLS_CERT_FILE=
OTEL_TLS_KEY_FILE=

# ============================================================
# PORTS
# Default values match infrastructure-review.md §5.
# Override only if a conflicting service binds these ports.
# ============================================================

# OTLP gRPC (backend clients).
OTEL_GRPC_PORT=4317

# OTLP HTTP (backend clients + mobile fallback).
OTEL_HTTP_PORT=4318

# OTLP HTTP (mobile-dedicated port, separate auth).
OTEL_HTTP_MOBILE_PORT=4319

# Collector self-metrics scrape target.
OTEL_SELF_METRICS_PORT=8888

# Health check extension.
OTEL_HEALTH_PORT=13133

# pprof (internal only).
OTEL_PPROF_PORT=1777

# zPages (internal only).
OTEL_ZPAGES_PORT=55679

# ============================================================
# PROMETHEUS — Phase 4 (active)
# ============================================================

# Remote write endpoint for the Collector's prometheusremotewrite exporter.
# Uses Docker Compose service name (not 127.0.0.1) so the Collector
# container can reach Prometheus via the ixora-observability network.
# ADR-028: Collector → Prometheus via internal network only.
PROMETHEUS_REMOTE_WRITE_ENDPOINT=http://prometheus:9090/api/v1/write

# Host port for Prometheus UI / API (127.0.0.1 only).
# Used by Grafana (Phase 9) as a datasource and for ops debugging.
PROMETHEUS_PORT=9090

# ============================================================
# LOKI — Phase 5 (active)
# ============================================================

# Push API endpoint for the Collector's loki exporter.
# Uses Docker Compose service name (not 127.0.0.1) so the Collector
# container can reach Loki via the ixora-observability network.
# ADR-028: Collector → Loki via internal network only.
# Applications NEVER communicate with Loki directly.
LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push

# Host port for Loki API / LogQL queries (127.0.0.1 only).
# Used by Grafana (Phase 9) as a datasource and for ops debugging.
LOKI_PORT=3100

# ============================================================
# TEMPO — Phase 6 (active)
# ============================================================

# OTLP gRPC endpoint for the Collector's otlp/tempo exporter.
# Uses Docker Compose service name (not 127.0.0.1) so the Collector
# container can reach Tempo via the ixora-observability network.
# ADR-028: Collector → Tempo via internal network only.
# Applications NEVER communicate with Tempo directly.
TEMPO_ENDPOINT=http://tempo:4317

# Host port for Tempo HTTP query API / TraceQL (127.0.0.1 only).
# Used by Grafana (Phase 9) as a datasource and for ops debugging.
TEMPO_PORT=3200

# Host port for Tempo OTLP gRPC receiver (127.0.0.1 only — ops only).
# Container-to-container Collector→Tempo uses Docker network DNS (no port binding needed).
# IMPORTANT: Must differ from OTEL_GRPC_PORT (4317) to avoid host port conflict
# when the Collector and Tempo run on the same host.
TEMPO_OTLP_GRPC_PORT=14317

# ============================================================
# GRAFANA — Phase 8.1 (active)
# ============================================================

# Grafana OSS version (matches release tag).
# Pin to a specific version — never use :latest.
GRAFANA_VERSION=11.3.0

# Admin credentials — change immediately after first deploy.
# Generate with: openssl rand -hex 16
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Host port for Grafana UI (127.0.0.1 only; expose via reverse proxy).
GRAFANA_PORT=3000

# Public root URL — must match the URL users access Grafana from.
# Development: http://localhost:3000
# Staging: https://grafana-staging.ixora-app.app
GF_SERVER_ROOT_URL=http://localhost:3000

# Cookie security — set to true when serving Grafana over HTTPS.
# Must be true on staging/production.
GF_SECURITY_COOKIE_SECURE=false

# Cookie SameSite policy.
# Allowed: disabled | lax | strict | none
# Use lax for development, strict for production.
GF_SECURITY_COOKIE_SAMESITE=lax

# Log level — warn for production, info for debugging.
# Allowed: debug | info | warn | error | critical
GF_LOG_LEVEL=warn
