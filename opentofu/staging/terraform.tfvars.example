# ══════════════════════════════════════════════════════════════════════════════
# EXAMPLE ONLY — copy to `terraform.tfvars` (gitignored) and fill real values.
# Never commit terraform.tfvars or *.auto.tfvars with secrets.
# Prefer CI OIDC / sealed secrets for production-like pipelines.
# ══════════════════════════════════════════════════════════════════════════════

do_token          = "dop_v1_REPLACE_ME"
spaces_access_id  = "REPLACE_SPACES_KEY_ID"
spaces_secret_key = "REPLACE_SPACES_SECRET"

github_repo_api    = "your-org/your-laravel-api-repo"
github_repo_admin  = "your-org/your-nuxt-admin-repo"
github_branch      = "staging"

api_domain    = "staging-api.ixora-app.app"
admin_domain  = "staging-admin.ixora-app.app"

# Laravel CORS (explicit origins only; empty uses https://{admin_domain},http://localhost:3000,http://localhost:5173).
# api_cors_allowed_origins = "https://staging-admin.ixora-app.app,http://localhost:3000,http://localhost:5173"

manage_spaces_bucket = true
spaces_bucket_name   = "ixora-buckets-staging-example"
# Bucket names are globally unique — pick a unique slug if ixora-buckets is taken.

db_cluster_name = "ixora-staging-postgres"
db_node_size    = "db-s-1vcpu-1gb"

# Postgres firewall — extra trusted public IPs (beyond VPC CIDR in database.tf).
# Default includes 108.180.255.58 (already on remote/staging; preserved from manual DO console rule).
# db_firewall_extra_ip_addrs = ["108.180.255.58"]

# Laravel runtime secrets — set via environment or a local untracked tfvars file:
# api_app_key = "base64:..."
#
# Firebase Admin SDK — discrete env vars (recommended; maps to Laravel FIREBASE_*). PEM often uses escaped \n in HCL/tfvars strings.
# api_firebase_type                         = "service_account"
# api_firebase_project_id                   = "your-gcp-project"
# api_firebase_private_key_id               = "..."
# api_firebase_private_key                  = "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# api_firebase_client_email                 = "firebase-adminsdk@your-project.iam.gserviceaccount.com"
# api_firebase_client_id                    = "..."
# api_firebase_token_uri                    = "https://oauth2.googleapis.com/token"
# api_firebase_auth_uri                     = "https://accounts.google.com/o/oauth2/auth"
# api_firebase_auth_provider_x509_cert_url  = "https://www.googleapis.com/oauth2/v1/certs"
# api_firebase_client_x509_cert_url         = "https://www.googleapis.com/robot/v1/metadata/x509/..."
#
# api_mail_password    = "..."
# api_do_spaces_key    = "..."
# api_do_spaces_secret = "..."

admin_access_review_email = "ops-example@yourcompany.invalid"

# Push notifications — PUSH_PROVIDER=fcm is set in app-api.tf (local.api_worker_runtime_env), shared by api + workers.
# Currently fcm is the only supported production provider; future values may include noop (dev/test), apns, webpush, etc.

api_env_general = {
  # MAIL_MAILER = "smtp"
  # MAIL_HOST   = "smtp.example.com"
  # MAIL_PORT   = "587"
  # MAIL_USERNAME = "notifications@example.com"
  # MAIL_FROM_ADDRESS = "notifications@example.com"
  # MAIL_FROM_NAME    = "Ixora Staging"

  # OpenTelemetry — REQUIRED for back_vibes telemetry to reach the observability
  # stack. Not declared as discrete vars in app-api.tf; must be set here.
  # A `tofu apply` without these silently strips any equivalent env vars that
  # were only ever set out-of-band via the DO dashboard (TD-5 incident,
  # observability-foundation/mvp/tasks.md Phase 8.9, 2026-08-22) — the
  # digitalocean_app env list is a full declarative replacement, not additive.
  # OTEL_ENVIRONMENT            = "staging"
  # OTEL_SDK_DISABLED           = "false"
  # OTEL_PHP_AUTOLOAD_ENABLED   = "true"
  # OTEL_SERVICE_NAME           = "back_vibes-api"
  # OTEL_RESOURCE_ATTRIBUTES    = "deployment.environment=staging,service.namespace=ixora"
  # OTEL_EXPORTER_OTLP_ENDPOINT = "https://otel-staging.ixora-app.app"
  # OTEL_EXPORTER_OTLP_PROTOCOL = "http/protobuf"
  # OTEL_TRACES_EXPORTER        = "otlp"
  # OTEL_LOGS_EXPORTER          = "otlp"
  # OTEL_METRICS_EXPORTER       = "otlp"
  # OTEL_PROPAGATORS            = "tracecontext,baggage"
  # OTEL_SERVICE_NAMESPACE      = "ixora"
  # OTEL_TRACES_SAMPLER         = "always_on"
  # OTEL_DEPLOYMENT_ENVIRONMENT = "staging"
  # OTEL_LOG_LEVEL              = "info"
}

# OTEL_EXPORTER_OTLP_HEADERS carries the OTLP ingest bearer token — SECRET, not
# GENERAL. Value must match the observability host's OTEL_INGEST_API_KEY_BACKEND.
api_secrets_extra = {
  # OTEL_EXPORTER_OTLP_HEADERS = "Authorization=Bearer <otel-ingest-api-key-backend>"
}

nuxt_public_api_base_url = "https://staging-api.ixora-app.app/api"

# ── Observability host (Phase 8.8.5 / 8.8.6) ─────────────────────────────────
# Required before `tofu apply` when observability_enabled = true (default).
#
# observability_enabled             = true
# observability_droplet_size        = "s-4vcpu-8gb"   # 4 vCPU, 8 GB RAM, 160 GB SSD
# observability_ssh_key_ids         = ["YOUR_DO_SSH_KEY_ID"]
# observability_ssh_allowed_cidrs   = ["YOUR.PUBLIC.IP/32"]
# observability_grafana_hostname    = "grafana-staging.ixora-app.app"
# observability_otel_hostname       = "otel-staging.ixora-app.app"
# observability_otel_mobile_hostname = "otel-mobile-staging.ixora-app.app"
# observability_use_block_volume    = false          # Strategy A: root disk (default)
# observability_use_reserved_ip     = false          # Reserve a floating IP for DNS stability
#
# ── Observability DNS (Phase 8.8.6) ──────────────────────────────────────────
# Option A — DigitalOcean DNS manages the records automatically:
#   observability_manage_dns      = true
#   observability_dns_zone_name   = "ixora-app.app"   # must exist in DO DNS
#   observability_dns_ttl         = 300
#
# Option B — External DNS (Cloudflare, Route 53, registrar, etc.):
#   observability_manage_dns      = false             # default
#   # After apply, run:
#   #   tofu output observability_dns_requirements
#   # and create the A records shown at your DNS provider.
#
# After apply: if using Option B, create DNS A records, then SSH to the host,
# clone ixora-infra, run scripts/bootstrap-collector-env.sh + scripts/deploy-observability.sh

# nuxt_public_firebase_api_key             = "AIza..."
# nuxt_public_firebase_auth_domain         = "your-app.firebaseapp.com"
# nuxt_public_firebase_project_id          = "your-project"
# nuxt_public_firebase_storage_bucket      = "your-project.appspot.com"
# nuxt_public_firebase_messaging_sender_id = "123456789"
# nuxt_public_firebase_app_id              = "1:123:web:abc"
