# Load Testing — Environment Variables
#
# Copy this file to .env (git-ignored) and fill in real values.
# NEVER commit a .env file with real credentials.
#
# Source before running k6:
#   set -a && source .env && set +a
#   k6 run scripts/read-flows-smoke.js

# ── Firebase credentials ──────────────────────────────────────────────────────
# Same values used by qa/scheduler-e2e/scripts/staging-api-qa.sh.
# Read from front_vibes/.env: VITE_FIREBASE_API_KEY, E2E_USER_EMAIL, E2E_USER_PASSWORD.

FIREBASE_API_KEY=your-firebase-api-key-here
E2E_USER_EMAIL=your-test-account@example.com
E2E_USER_PASSWORD=your-test-account-password

# ── API target ────────────────────────────────────────────────────────────────
# Default is production staging URL. Override for local back_vibes dev.
# K6_API_BASE=https://staging-api.ixora-app.app

# ── Load profile overrides ────────────────────────────────────────────────────
# Smoke (acceptance): 1 VU, 3 iterations.
# K6_VUS=1
# K6_ITERATIONS=3

# Default baseline (conservative for basic-xxs): 3 VUs, 10 iterations.
# K6_VUS=3
# K6_ITERATIONS=10

# ── Prometheus remote-write (optional — see README.md §Prometheus) ────────────
# Requires k6 to run on the observability host (137.184.163.187) or via SSH tunnel.
# K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write
